<?xml version="1.0" encoding="utf-8"?>
<!-- Car Dashboard: a car-style Home screen for Android head units and phones. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <!-- Maps online; online and offline state. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The car on the map, zoom by speed. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- The Clear button: ends other apps' background processes. -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />

    <queries>
        <!-- The apps for the Home tiles and All apps. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Which Home is the default (Back, settings). -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- Startup music: the music app's media service and media-button receiver. -->
        <intent>
            <action android:name="android.media.browse.MediaBrowserService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MEDIA_BUTTON" />
        </intent>
        <!-- App info from Dashboard settings. -->
        <intent>
            <action android:name="android.settings.APPLICATION_DETAILS_SETTINGS" />
            <data android:scheme="package" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Dashboard"
        android:allowBackup="false">

        <!-- The dashboard: picked as Home in the Home app chooser, and an ordinary app icon too. -->
        <activity
            android:name=".DashboardActivity"
            android:label="@string/dash_home_name"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:clearTaskOnLaunch="true"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|uiMode"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- All apps, full screen in its own task. -->
        <activity
            android:name=".DashboardAppsActivity"
            android:label="@string/dash_all_apps"
            android:exported="false"
            android:taskAffinity="com.prajwal.cardashboard.apps"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|uiMode" />

        <!-- Dashboard settings: the current setup and resets. -->
        <activity
            android:name=".DashboardSettingsActivity"
            android:label="@string/set_title"
            android:exported="false"
            android:taskAffinity="com.prajwal.cardashboard.settings"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|uiMode" />

        <!-- Notification access: other apps' media sessions (Now playing) and the navigation app's next turn. -->
        <service
            android:name=".MusicListener"
            android:label="@string/dash_music_listener_name"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
