<?xml version="1.0" encoding="utf-8"?>
<!-- Shared looks: the pill buttons (top bar, panels) and the round map buttons on the navigation screen. -->
<resources>
    <!-- A pill: rounded, light glass, white text; dark text on a light fill when focused (a remote or keyboard). -->
    <style name="PillButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/pill_bg</item>
        <item name="android:textColor">@drawable/pill_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/outfit_medium</item>
        <item name="android:drawablePadding">9dp</item>
        <item name="android:drawableTint">@drawable/pill_text</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>

    <!-- Round buttons on the navigation map (voice, zoom, whole route, follow the car). -->
    <style name="NavMapButton">
        <item name="android:layout_width">46dp</item>
        <item name="android:layout_height">46dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:background">@drawable/dash_speed_bg</item>
    </style>
</resources>
