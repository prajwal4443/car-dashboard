<?xml version="1.0" encoding="utf-8"?>
<!-- One row on the dashboard settings page: a title and its current value. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:minHeight="56dp"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:background="@drawable/dash_tile_bg"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/dashSettingTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/dash_text"
        android:textSize="17sp"
        android:fontFamily="@font/outfit_medium" />

    <TextView
        android:id="@+id/dashSettingValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/dash_text_dim"
        android:textSize="14sp" />
</LinearLayout>
