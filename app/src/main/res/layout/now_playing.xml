<?xml version="1.0" encoding="utf-8"?>
<!-- The Now playing card (NowPlaying), included by both dashboard layouts with android:id="@+id/nowPlaying":
     the album art fills the card behind a dark fade, with the song and the controls on top. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/dash_card_bg">

    <ImageView
        android:id="@+id/npBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <View
        android:id="@+id/npScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/dash_art_scrim"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/dash_card_pad">

        <LinearLayout
            android:id="@+id/npInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground">

            <ImageView
                android:id="@+id/npArt"
                android:layout_width="@dimen/dash_art"
                android:layout_height="@dimen/dash_art"
                android:background="@drawable/dash_art_bg"
                android:importantForAccessibility="no"
                android:scaleType="center"
                android:src="@drawable/ic_music_note" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/npSource"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:letterSpacing="0.15"
                    android:textColor="@color/dash_text_dim"
                    android:textSize="11sp"
                    android:fontFamily="@font/outfit_medium" />

                <TextView
                    android:id="@+id/npTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textColor="@color/dash_text"
                    android:textSize="@dimen/dash_title_text"
                    android:fontFamily="@font/outfit_medium" />

                <TextView
                    android:id="@+id/npArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textColor="@color/dash_text_mid"
                    android:textSize="15sp"
                    android:fontFamily="@font/outfit_regular" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/npAccess"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:minHeight="44dp"
            android:gravity="center_vertical"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground"
            android:text="@string/np_access"
            android:textColor="@color/dash_accent"
            android:textSize="13sp"
            android:fontFamily="@font/outfit_medium" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/npProgressRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="invisible">

            <ProgressBar
                android:id="@+id/npProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:progressDrawable="@drawable/dash_progress" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/npElapsed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/dash_text_dim"
                    android:textSize="12sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/npDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/dash_text_dim"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center">

            <ImageButton
                android:id="@+id/npPrev"
                android:layout_width="@dimen/dash_skip"
                android:layout_height="@dimen/dash_skip"
                android:background="@drawable/dash_round_btn"
                android:contentDescription="@string/np_previous"
                android:src="@drawable/ic_skip_previous" />

            <ImageButton
                android:id="@+id/npPlay"
                android:layout_width="@dimen/dash_play"
                android:layout_height="@dimen/dash_play"
                android:layout_marginStart="@dimen/dash_skip_gap"
                android:layout_marginEnd="@dimen/dash_skip_gap"
                android:background="@drawable/dash_play_btn"
                android:contentDescription="@string/np_play"
                android:src="@drawable/ic_play" />

            <ImageButton
                android:id="@+id/npNext"
                android:layout_width="@dimen/dash_skip"
                android:layout_height="@dimen/dash_skip"
                android:background="@drawable/dash_round_btn"
                android:contentDescription="@string/np_next"
                android:src="@drawable/ic_skip_next" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
