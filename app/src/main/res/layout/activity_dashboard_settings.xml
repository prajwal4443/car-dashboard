<?xml version="1.0" encoding="utf-8"?>
<!-- Dashboard settings (DashboardSettingsActivity): current setup and resets, one scrolling list. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/dash_pad">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/set_title"
            android:textColor="@color/dash_text"
            android:textSize="28sp"
            android:fontFamily="@font/outfit_medium" />

        <TextView
            android:id="@+id/dashSettingsClose"
            style="@style/PillButton"
            android:text="@string/dash_done" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/dash_gap"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/dashSettingsRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
