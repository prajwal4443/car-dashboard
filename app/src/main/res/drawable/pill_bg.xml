<?xml version="1.0" encoding="utf-8"?>
<!-- The pill buttons' background (PillButton): light glass; solid white when focused; blue when activated (the
     route picked on the navigation screen). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#F2FFFFFF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#552979FF" />
            <stroke android:width="1.5dp" android:color="#FF5E9BFF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#22FFFFFF" />
            <stroke android:width="1dp" android:color="#33FFFFFF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
</selector>
