<?xml version="1.0" encoding="utf-8"?>
<!-- The pill buttons' text and icon colour: dark on the focused (white) pill, white otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:color="#FF111111" />
    <item android:color="#FFFFFFFF" />
</selector>
